{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react",
    "jsxFactory": "h",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [".claude-plugin/types", "hooks", "tests", "types"]
}
